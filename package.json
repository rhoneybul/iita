{
  "name": "iita",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "npm run dev:server & npm run dev:app",
    "dev:app": "npx expo start",
    "dev:web": "npx expo start --web",
    "dev:server": "npm --prefix server run dev",
    "setup": "npm install && npm --prefix server install && cp -n server/.env.example server/.env 2>/dev/null; cp -n .env.example .env 2>/dev/null; echo '\\n✅ Setup done. Fill in server/.env and .env with your API keys.'"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.49.4",
    "expo": "~55.0.23",
    "expo-apple-authentication": "~55.0.13",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-crypto": "~55.0.14",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.22",
    "expo-secure-store": "~55.0.13",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "^55.0.12",
    "typescript": "~5.9.2"
  }
