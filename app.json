{
  "expo": {
    "name": "iita",
    "slug": "iita",
    "scheme": "iita",
    "version": "0.1.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rhoneybul.iita",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "iita doesn't access your photo library. This string is required by Apple because a bundled framework references the photos API.",
        "NSCameraUsageDescription": "iita doesn't access your camera. This string is required by Apple because a bundled framework references the camera API."
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/splash-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "package": "com.rhoneybul.iita",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "iita",
      "shortName": "iita",
      "description": "Plan the week together",
      "themeColor": "#F6237D",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-notifications"
    ],
    "extra": {
      "serverUrl": "",
      "eas": {
        "projectId": "4edf0333-ee38-4e43-892b-d6069bb45c88"
      }
    },
    "owner": "rhoneybul"
  }
}
