# Supabase — auth + DB. Leave blank to run in local-only / guest mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — error reporting. Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Server URL — used by the LLM week-parser. Leave blank to fall back to
# the on-device heuristic parser (no LLM, still works offline).
EXPO_PUBLIC_SERVER_URL=
